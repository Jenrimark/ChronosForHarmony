                systemContent += `${date}ï¼š\n`;
                dateBills.forEach((bill, index) => {
                    // Billå¯¹è±¡æœ‰isIncomeæ–¹æ³•
                    const isIncome = bill.isIncome();
                    const typeText = isIncome ? 'æ”¶å…¥' : 'æ”¯å‡º';
                    const categoryText = this.getCategoryName(bill.category || '');
                    systemContent += `   ${index + 1}. ${typeText} Â¥${bill.amount.toFixed(2)} - ${categoryText}`;
                    if (bill.description) {
                        systemContent += ` (${bill.description})`;
                    }
                    systemContent += '\n';
                });
                systemContent += '\n';
            });
        }
        systemContent += '\nè¯·æ ¹æ®ä»¥ä¸Šä¿¡æ¯å›ç­”ç”¨æˆ·çš„é—®é¢˜ã€‚å¦‚æœç”¨æˆ·è¯¢é—®å…·ä½“çš„æ•°æ®ï¼Œè¯·å‡†ç¡®å¼•ç”¨ä¸Šè¿°ä¿¡æ¯ã€‚';
        // æ›´æ–°ç³»ç»Ÿæ¶ˆæ¯
