  /**
   * é€šè¿‡Account Kitè·å–ç”¨æˆ·å¤´åƒæ˜µç§°
   * @param uiContext UIContextå¯¹è±¡ï¼Œç”¨äºåˆ›å»ºAuthenticationController
   */
  async fetchUserProfileWithAccountKit(uiContext: UIContext): Promise<boolean> {
    try {
      hilog.info(0x0000, TAG, 'å¼€å§‹é€šè¿‡Account Kitè·å–å¤´åƒæ˜µç§°...');
      
      // åˆ›å»ºæˆæƒè¯·æ±‚
      const authRequest = new authentication.HuaweiIDProvider().createAuthorizationWithHuaweiIDRequest();
      // è·å–å¤´åƒæ˜µç§°éœ€è¦ä¼ profile scope
      authRequest.scopes = ['profile'];
      // å…ƒæœåŠ¡éœ€ä¼ å…¥supportAtomicServiceå‚æ•°å¹¶è®¾ç½®ä¸ºtrue
      authRequest.supportAtomicService = true;
      // è‹¥å¼€å‘è€…éœ€è¦è¿›è¡ŒæœåŠ¡ç«¯å¼€å‘ä»¥è·å–å¤´åƒæ˜µç§°ï¼Œåˆ™éœ€ä¼ å¦‚ä¸‹permissionè·å–authorizationCode
      authRequest.permissions = ['serviceauthcode'];
      // ç”¨æˆ·æ˜¯å¦éœ€è¦ç™»å½•æˆæƒï¼Œè¯¥å€¼ä¸ºtrueä¸”ç”¨æˆ·æœªç™»å½•æˆ–æœªæˆæƒæ—¶ï¼Œä¼šæ‹‰èµ·ç”¨æˆ·ç™»å½•æˆ–æˆæƒé¡µé¢
      authRequest.forceAuthorization = true;
      // ç”¨äºé˜²è·¨ç«™ç‚¹è¯·æ±‚ä¼ªé€ 
      authRequest.state = util.generateRandomUUID();

      // åˆ›å»ºAuthenticationController - éœ€è¦ä¼ å…¥Contextï¼Œé€šè¿‡UIContextçš„getHostContext()è·å–
      const controller = new authentication.AuthenticationController(uiContext.getHostContext());
      
      // æ‰§è¡Œæˆæƒè¯·æ±‚
      const data = await controller.executeRequest(authRequest);
      const authorizationWithHuaweiIDResponse = data as authentication.AuthorizationWithHuaweiIDResponse;
      
      // éªŒè¯state
      const state = authorizationWithHuaweiIDResponse.state;
      if (state && authRequest.state !== state) {
        hilog.error(0x0000, TAG, 'æˆæƒå¤±è´¥ï¼šstateä¸åŒ¹é…ï¼Œresponse state: %{public}s', state);
        return false;
      }

      hilog.info(0x0000, TAG, 'æˆæƒæˆåŠŸ');
      
      // è§£æå¤´åƒæ˜µç§°
      const authorizationWithHuaweiIDCredential = authorizationWithHuaweiIDResponse?.data;
      const avatarUri = authorizationWithHuaweiIDCredential?.avatarUri;
      const nickName = authorizationWithHuaweiIDCredential?.nickName;
      
      hilog.info(0x0000, TAG, 'è·å–åˆ°å¤´åƒ: %{public}s, æ˜µç§°: %{public}s', 
        avatarUri || 'æ— ', nickName || 'æ— ');

      // æ›´æ–°ç”¨æˆ·ä¿¡æ¯
      if (this.currentUser) {
        if (nickName && nickName.trim().length > 0) {
          this.currentUser.displayName = nickName;
        }
        if (avatarUri && avatarUri.trim().length > 0) {
          this.currentUser.avatarUri = avatarUri;
        }
        // ä¿å­˜åˆ°æœ¬åœ°ç¼“å­˜
        await this.saveUserInfoToCache();
        hilog.info(0x0000, TAG, 'ç”¨æˆ·å¤´åƒæ˜µç§°å·²æ›´æ–°');
        return true;
      } else {
        hilog.warn(0x0000, TAG, 'å½“å‰æ²¡æœ‰ç™»å½•ç”¨æˆ·ï¼Œæ— æ³•æ›´æ–°å¤´åƒæ˜µç§°');
        return false;
      }
    } catch (error) {
      const err = error as BusinessError;
      this.handleAccountKitError(err);
      return false;
    }
  }

  /**
   * å¤„ç†Account Kité”™è¯¯
   */
  private handleAccountKitError(error: BusinessError): void {
    const ERROR_CODE_LOGIN_OUT = 1001502001; // è´¦å·æœªç™»å½•
    const ERROR_CODE_NETWORK_ERROR = 1001502005; // ç½‘ç»œé”™è¯¯
    const ERROR_CODE_USER_CANCEL = 1001502012; // ç”¨æˆ·å–æ¶ˆæˆæƒ
    const ERROR_CODE_SYSTEM_SERVICE = 12300001; // ç³»ç»ŸæœåŠ¡å¼‚å¸¸
    const ERROR_CODE_REQUEST_REFUSE = 1001500002; // é‡å¤è¯·æ±‚

    if (error.code === ERROR_CODE_LOGIN_OUT) {
      hilog.error(0x0000, TAG, 'ç”¨æˆ·æœªç™»å½•åä¸ºè´¦å·ï¼Œè¯·ç™»å½•åä¸ºè´¦å·å¹¶é‡è¯•');
    } else if (error.code === ERROR_CODE_NETWORK_ERROR) {
      hilog.error(0x0000, TAG, 'ç½‘ç»œå¼‚å¸¸ï¼Œè¯·æ£€æŸ¥å½“å‰ç½‘ç»œçŠ¶æ€å¹¶é‡è¯•');
    } else if (error.code === ERROR_CODE_USER_CANCEL) {
      hilog.warn(0x0000, TAG, 'ç”¨æˆ·å–æ¶ˆæˆæƒ');
    } else if (error.code === ERROR_CODE_SYSTEM_SERVICE) {
      hilog.error(0x0000, TAG, 'ç³»ç»ŸæœåŠ¡å¼‚å¸¸ï¼Œè¯·ç¨åé‡è¯•');
    } else if (error.code === ERROR_CODE_REQUEST_REFUSE) {
      hilog.warn(0x0000, TAG, 'é‡å¤è¯·æ±‚ï¼Œæ— éœ€å¤„ç†');
    } else {
      hilog.error(0x0000, TAG, 'è·å–å¤´åƒæ˜µç§°å¤±è´¥: Code: %{public}s, Message: %{public}s',
        String(error.code), String(error.message));
    }
  }

  /**
   * è·å–å½“å‰ç™»å½•ç”¨æˆ·
   */
  async getCurrentUserAsync(): Promise<UserInfo | null> {
    try {
      const initialized = this.initAuth();
      if (!initialized) {
        return null;
      }

      const user = await auth.getCurrentUser();
      if (user) {
        // å¦‚æœå·²æœ‰ç¼“å­˜çš„ç”¨æˆ·ä¿¡æ¯ï¼Œä½¿ç”¨ç¼“å­˜
        if (this.currentUser && this.currentUser.uid === user.getUid()) {
          return this.currentUser;
        }
        
        this.currentUser = {
          uid: user.getUid(),
          displayName: user.getDisplayName() || 'åä¸ºç”¨æˆ·',
          avatarUri: user.getPhotoUrl() || '',
          email: user.getEmail() || '',
          phone: user.getPhone() || ''
        };
        hilog.info(0x0000, TAG, 'è·å–å½“å‰ç”¨æˆ·æˆåŠŸ, uid: %{public}s', this.currentUser.uid);
        return this.currentUser;
      }
      hilog.info(0x0000, TAG, 'å½“å‰æ²¡æœ‰ç™»å½•ç”¨æˆ·');
      return null;
    } catch (error) {
      const err = error as BusinessError;
      hilog.error(0x0000, TAG, 'è·å–å½“å‰ç”¨æˆ·å¤±è´¥: %{public}s', String(err.message));
      return null;
    }
  }

  /**
   * é€€å‡ºç™»å½•
   */
  async logout(): Promise<boolean> {
    try {
      const initialized = this.initAuth();
      if (!initialized) {
        return false;
      }

      await auth.signOut();
      this.currentUser = null;
      // æ¸…é™¤æœ¬åœ°ç¼“å­˜
      await this.clearCachedUserInfo();
      hilog.info(0x0000, TAG, 'é€€å‡ºç™»å½•æˆåŠŸ');
      return true;
    } catch (error) {
      const err = error as BusinessError;
      hilog.error(0x0000, TAG, 'é€€å‡ºç™»å½•å¤±è´¥: %{public}s', String(err.message));
      return false;
    }
  }

  /**
   * è·å–å½“å‰ç”¨æˆ·ï¼ˆåŒæ­¥ï¼‰
   */
  getCurrentUser(): UserInfo | null {
    return this.currentUser;
  }

  /**
   * æ˜¯å¦å·²ç™»å½•
   */
  isLoggedIn(): boolean {
    return this.currentUser !== null;
  }
}
