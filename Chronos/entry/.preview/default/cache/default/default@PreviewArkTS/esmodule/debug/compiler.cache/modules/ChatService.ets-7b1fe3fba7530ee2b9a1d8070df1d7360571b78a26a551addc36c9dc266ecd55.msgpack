        // å¦‚æœå†…å®¹å¾ˆçŸ­ï¼Œç›´æ¥ä¸€æ¬¡æ€§è¾“å‡º
        if (content.length <= 50) {
            console.info('å†…å®¹è¾ƒçŸ­ï¼Œç›´æ¥è¾“å‡ºå…¨éƒ¨');
            onChunk(content);
