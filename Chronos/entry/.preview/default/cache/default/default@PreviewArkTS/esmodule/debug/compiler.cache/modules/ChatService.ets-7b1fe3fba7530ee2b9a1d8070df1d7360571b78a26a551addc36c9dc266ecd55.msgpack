            console.info(`è¾“å‡ºç¬¬${Math.floor(i / chunkSize) + 1}æ‰¹å†…å®¹ï¼Œé•¿åº¦:`, chunk.length);
            onChunk(chunk);
            // å‡å°‘å»¶è¿Ÿï¼ŒåŠ å¿«æ˜¾ç¤ºé€Ÿåº¦
            if (i + chunkSize < words.length) {
                await new Promise((resolve) => setTimeout(resolve, 20));
