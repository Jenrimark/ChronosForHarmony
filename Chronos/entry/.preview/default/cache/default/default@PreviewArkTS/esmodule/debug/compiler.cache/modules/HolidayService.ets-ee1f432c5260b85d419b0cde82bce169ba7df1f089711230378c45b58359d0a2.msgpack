        }
        return result;
    }
    /**
     * æ‰¹é‡è·å–æ—¥æœŸçš„èŠ‚å‡æ—¥
     */
    async getHolidaysByDates(dates) {
        const holidays = [];
        for (const date of dates) {
            const holiday = await this.getHolidayByDate(date);
            if (holiday && (holiday.dayType === 1 || holiday.dayType === 2)) {
                holidays.push(holiday);
            }
        }
        return holidays;
    }
    /**
     * è·å–æŒ‡å®šæœˆä»½çš„èŠ‚å‡æ—¥
     */
    async getHolidaysByMonth(year, month) {
        const startDate = new Date(year, month, 1);
        const endDate = new Date(year, month + 1, 0);
        const holidays = [];
        console.info(`è·å–${year}å¹´${month + 1}æœˆçš„èŠ‚å‡æ—¥`);
        const currentDate = new Date(startDate);
        while (currentDate <= endDate) {
            const holiday = await this.getHolidayByDate(new Date(currentDate));
            if (holiday && (holiday.dayType === 1 || holiday.dayType === 2)) {
                holidays.push(holiday);
            }
            currentDate.setDate(currentDate.getDate() + 1);
        }
        console.info(`æŸ¥è¯¢å®Œæˆï¼Œæ‰¾åˆ°${holidays.length}ä¸ªèŠ‚å‡æ—¥`);
        return holidays;
    }
    /**
     * è§£æèŠ‚å‡æ—¥æ•°æ®
     */
    parseHolidayData(data) {
        let holidayType;
        let name;
        if (data.type === 0) {
            holidayType = HolidayType.WORKDAY;
            name = 'å·¥ä½œæ—¥';
        }
        else if (data.type === 1) {
            holidayType = HolidayType.HOLIDAY;
            name = data.typeDes || 'ä¼‘æ¯æ—¥';
        }
        else if (data.type === 2) {
            holidayType = HolidayType.FESTIVAL;
            name = data.typeDes || 'èŠ‚å‡æ—¥';
        }
        else {
            holidayType = HolidayType.WORKDAY;
            name = data.typeDes || 'å·¥ä½œæ—¥';
        }
        return new Holiday({
            name: name,
            date: data.date,
            type: holidayType,
            dayType: data.type,
            detailsType: data.detailsType,
            lunarCalendar: data.lunarCalendar,
            solarTerms: data.solarTerms,
            constellation: data.constellation,
            chineseZodiac: data.chineseZodiac,
            suit: data.suit || '',
            avoid: data.avoid || '',
            yearTips: data.yearTips,
            weekDay: data.weekDay
        });
    }
