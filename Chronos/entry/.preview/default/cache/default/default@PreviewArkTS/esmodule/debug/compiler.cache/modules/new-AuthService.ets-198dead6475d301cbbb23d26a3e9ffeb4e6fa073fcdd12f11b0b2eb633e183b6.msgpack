  /**
   * åä¸ºè´¦å·ç™»å½•ï¼ˆåŸºç¡€ç™»å½•ï¼Œä¸è·å–å¤´åƒæ˜µç§°ï¼‰
   */
  async login(): Promise<UserInfo | null> {
    try {
      hilog.info(0x0000, TAG, 'å¼€å§‹åä¸ºè´¦å·ç™»å½•...');
      
      // ç¡®ä¿ Auth SDK å·²åˆå§‹åŒ–
      const initialized = this.initAuth();
      if (!initialized) {
        hilog.error(0x0000, TAG, 'Auth SDK æœªåˆå§‹åŒ–');
        return null;
      }

      // æ£€æŸ¥æ˜¯å¦å·²ç™»å½•
      hilog.info(0x0000, TAG, 'æ£€æŸ¥å½“å‰ç™»å½•çŠ¶æ€...');
      const currentUser = await auth.getCurrentUser();
      if (currentUser !== null) {
        hilog.info(0x0000, TAG, 'ç”¨æˆ·å·²ç™»å½•ï¼Œå…ˆé€€å‡º...');
        await auth.signOut();
      }

      // æ‰§è¡Œç™»å½•
      hilog.info(0x0000, TAG, 'æ‰§è¡Œåä¸ºè´¦å·ç™»å½•...');
      const signInResult = await auth.signIn({
        autoCreateUser: true,
        credentialInfo: {
          kind: 'hwid'
        }
      });

      const user = signInResult.getUser();
      
      this.currentUser = {
        uid: user.getUid(),
        displayName: user.getDisplayName() || 'åä¸ºç”¨æˆ·',
        avatarUri: user.getPhotoUrl() || '',
        email: user.getEmail() || '',
        phone: user.getPhone() || ''
      };

      hilog.info(0x0000, TAG, 'ç™»å½•æˆåŠŸ, uid: %{public}s', this.currentUser.uid);
      // ä¿å­˜åˆ°æœ¬åœ°ç¼“å­˜
      await this.saveUserInfoToCache();
      return this.currentUser;
    } catch (error) {
      const err = error as BusinessError;
