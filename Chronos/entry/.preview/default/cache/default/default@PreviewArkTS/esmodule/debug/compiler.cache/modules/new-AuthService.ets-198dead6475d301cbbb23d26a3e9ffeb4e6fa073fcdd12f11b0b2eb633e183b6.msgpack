      this.currentUser.avatarUri = avatarUri || this.currentUser.avatarUri;
      hilog.info(0x0000, TAG, 'ç”¨æˆ·ä¿¡æ¯å·²æ›´æ–° - æ˜µç§°: %{public}s', this.currentUser.displayName);
      // ä¿å­˜åˆ°æœ¬åœ°ç¼“å­˜
