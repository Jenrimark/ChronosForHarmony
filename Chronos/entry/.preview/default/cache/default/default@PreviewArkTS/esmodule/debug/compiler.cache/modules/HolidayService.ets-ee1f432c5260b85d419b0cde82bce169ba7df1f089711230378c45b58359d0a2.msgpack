    /**
     * æ ¹æ®æœˆæ—¥è·å–æ˜Ÿåº§
     */
    getConstellation(month, date) {
        const constellations = this.getConstellationList();
        for (const c of constellations) {
            if (c.startMonth === c.endMonth) {
                if (month === c.startMonth && date >= c.startDate && date <= c.endDate) {
                    return c.name;
                }
            }
            else {
                if ((month === c.startMonth && date >= c.startDate) || (month === c.endMonth && date <= c.endDate)) {
                    return c.name;
                }
            }
        }
        return 'æœªçŸ¥';
    }
    /**
     * å°†æœ¬åœ°æ•°æ®è½¬æ¢ä¸º MxnzpHolidayData æ ¼å¼ï¼ˆå…¼å®¹ç°æœ‰ä»£ç ï¼‰
     */
    convertToMxnzpFormat(localData, dateKey) {
        // è§£ææ—¥æœŸï¼Œç›´æ¥åˆ¤æ–­æ˜ŸæœŸå‡ ï¼ˆæ›´å¯é ï¼‰
        const dateParts = dateKey.split('-');
        const year = parseInt(dateParts[0]);
        const month = parseInt(dateParts[1]) - 1; // æœˆä»½ä»0å¼€å§‹
        const day = parseInt(dateParts[2]);
        const date = new Date(year, month, day);
        const jsWeekDay = date.getDay(); // JavaScriptçš„getDay(): 0=å‘¨æ—¥, 6=å‘¨å…­
        // åˆ¤æ–­æ˜¯å¦æ˜¯å‘¨æœ«ï¼šå‘¨å…­(6)æˆ–å‘¨æ—¥(0)
        const isWeekendDay = jsWeekDay === 0 || jsWeekDay === 6;
        // åˆ¤æ–­ç±»å‹ï¼šå‘¨æœ«ä¸ºä¼‘æ¯æ—¥(1)ï¼Œå·¥ä½œæ—¥ä¸º(0)
        const type = isWeekendDay ? 1 : 0;
        const typeDes = isWeekendDay ? 'ä¼‘æ¯æ—¥' : 'å·¥ä½œæ—¥';
        // è½¬æ¢æ˜ŸæœŸå‡ ä¸º1-7æ ¼å¼ï¼ˆå‘¨ä¸€=1, å‘¨æ—¥=7ï¼‰
        const weekDay = jsWeekDay === 0 ? 7 : jsWeekDay;
        const solarTermValue = localData.solarTerm ? localData.solarTerm : 'æ— ';
        const result = {
            date: dateKey,
            weekDay: weekDay,
            yearTips: localData.lunar.year,
            type: type,
            typeDes: typeDes,
            chineseZodiac: localData.zodiac,
            solarTerms: solarTermValue,
            lunarCalendar: localData.lunar.date,
            suit: '',
            avoid: '',
            dayOfYear: 0,
            weekOfYear: 0,
            constellation: this.getConstellation(localData.gregorian.month, localData.gregorian.date)
        };
        return result;
    }
    /**
     * è·å–æŒ‡å®šæ—¥æœŸçš„èŠ‚å‡æ—¥åŠä¸‡å¹´å†ä¿¡æ¯
     */
    async getHolidayByDate(date, retryCount = 0) {
        const dateKey = this.getDateKey(date);
        // æ£€æŸ¥ç¼“å­˜
        if (this.holidaysCache.has(dateKey)) {
            return this.holidaysCache.get(dateKey);
        }
        let mxnzpData = null;
        // æ ¹æ®æ•°æ®æºé€‰æ‹©è·å–æ–¹å¼
        if (this.dataSource === Constants.DATA_SOURCE_API) {
            // ä½¿ç”¨APIè·å–æ•°æ®
            mxnzpData = await this.getDataFromAPI(date);
        }
        else {
            // ä½¿ç”¨æœ¬åœ°æ•°æ®
            await this.loadLocalData();
            const localData = this.localDataMap.get(dateKey);
            if (localData) {
                mxnzpData = this.convertToMxnzpFormat(localData, dateKey);
            }
            else {
                console.warn(`HolidayService: æœªæ‰¾åˆ°æ—¥æœŸ ${dateKey} çš„æœ¬åœ°æ•°æ®`);
            }
        }
        if (!mxnzpData) {
            return null;
        }
        const holiday = this.parseHolidayData(mxnzpData);
        // ç¼“å­˜ç»“æœ
        this.holidaysCache.set(dateKey, holiday);
        this.calendarCache.set(dateKey, mxnzpData);
        return holiday;
    }
    /**
     * ä»APIè·å–æ•°æ®
     */
    async getDataFromAPI(date) {
        const dateKey = this.getDateKey(date);
        const year = date.getFullYear();
        try {
            // æ£€æŸ¥å¹´ä»½ç¼“å­˜
            if (!this.yearDataCache.has(year)) {
                // åŠ è½½æ•´å¹´æ•°æ®
                await this.loadYearDataFromAPI(year);
            }
            const yearData = this.yearDataCache.get(year);
            if (!yearData) {
                console.warn(`HolidayService: æœªæ‰¾åˆ° ${year} å¹´çš„APIæ•°æ®`);
                // APIå¤±è´¥æ—¶ï¼Œé™çº§åˆ°æœ¬åœ°æ•°æ®
                return await this.getDataFromLocal(date);
            }
            // æŸ¥æ‰¾æŒ‡å®šæ—¥æœŸçš„æ•°æ®
            const dayData = yearData.find(item => item.date === dateKey);
            if (dayData) {
                // APIè¿”å›çš„æ•°æ®åº”è¯¥åŒ…å«suitå’Œavoidå­—æ®µ
                // ç¡®ä¿è¿™äº›å­—æ®µå­˜åœ¨ï¼Œå¦‚æœAPIæ²¡æœ‰è¿”å›åˆ™ä½¿ç”¨ç©ºå­—ç¬¦ä¸²
                const result = {
                    date: dayData.date,
                    weekDay: dayData.weekDay,
                    yearTips: dayData.yearTips || '',
                    type: dayData.type,
                    detailsType: dayData.detailsType,
                    typeDes: dayData.typeDes || '',
                    chineseZodiac: dayData.chineseZodiac || '',
                    solarTerms: dayData.solarTerms || '',
                    lunarCalendar: dayData.lunarCalendar || '',
                    suit: dayData.suit || '',
                    avoid: dayData.avoid || '',
                    dayOfYear: dayData.dayOfYear || 0,
                    weekOfYear: dayData.weekOfYear || 0,
                    constellation: dayData.constellation || ''
                };
                // è°ƒè¯•æ—¥å¿—ï¼šæ£€æŸ¥suitå’Œavoidå­—æ®µ
                console.info(`HolidayService: ${dateKey} APIæ•°æ® - suit: "${result.suit}", avoid: "${result.avoid}"`);
                console.info(`HolidayService: ${dateKey} å®Œæ•´æ•°æ®:`, JSON.stringify(result));
                return result;
            }
            console.warn(`HolidayService: æœªæ‰¾åˆ°æ—¥æœŸ ${dateKey} çš„APIæ•°æ®`);
            // APIæ•°æ®ä¸­æ‰¾ä¸åˆ°ï¼Œé™çº§åˆ°æœ¬åœ°æ•°æ®
            return await this.getDataFromLocal(date);
        }
        catch (error) {
            console.error(`HolidayService: ä»APIè·å–æ•°æ®å¤±è´¥:`, error);
            // APIå¤±è´¥æ—¶ï¼Œé™çº§åˆ°æœ¬åœ°æ•°æ®
            return await this.getDataFromLocal(date);
        }
    }
    /**
     * ä»æœ¬åœ°æ•°æ®è·å–ï¼ˆé™çº§æ–¹æ¡ˆï¼‰
     */
    async getDataFromLocal(date) {
        const dateKey = this.getDateKey(date);
        await this.loadLocalData();
        const localData = this.localDataMap.get(dateKey);
        if (localData) {
