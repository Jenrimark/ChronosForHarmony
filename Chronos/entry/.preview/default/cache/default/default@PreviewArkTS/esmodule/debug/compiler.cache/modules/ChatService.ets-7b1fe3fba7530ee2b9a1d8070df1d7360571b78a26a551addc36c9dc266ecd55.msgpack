                const statusText = task.status === 'completed' ? 'å·²å®Œæˆ' :
                    task.status === 'in_progress' ? 'è¿›è¡Œä¸­' : 'å¾…åŠ';
                const priorityText = task.priority === 3 ? 'é«˜' :
