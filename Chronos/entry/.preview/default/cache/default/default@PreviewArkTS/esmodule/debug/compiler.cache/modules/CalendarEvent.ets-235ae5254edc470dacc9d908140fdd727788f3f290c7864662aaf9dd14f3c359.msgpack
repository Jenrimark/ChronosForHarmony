export function getViewTypeText(type: CalendarViewType): string {
  if (type === CalendarViewType.YEAR) return 'å¹´';
  if (type === CalendarViewType.MONTH) return 'æœˆ';
  if (type === CalendarViewType.WEEK) return 'å‘¨';
  if (type === CalendarViewType.DAY) return 'æ—¥';
  return 'æœˆ';
}
