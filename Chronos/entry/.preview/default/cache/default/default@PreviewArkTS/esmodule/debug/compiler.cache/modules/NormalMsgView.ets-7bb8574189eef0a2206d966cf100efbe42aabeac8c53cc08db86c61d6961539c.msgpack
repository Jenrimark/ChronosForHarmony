               .width(24)  // å›ºå®šåºå·å®½åº¦ä¸º24ï¼Œç¡®ä¿å¯¹é½
               .textAlign(TextAlign.Start)  // åºå·å·¦å¯¹é½
             // åŒ…è£¹æ–‡å­—å†…å®¹çš„åˆ—å®¹å™¨
             Column() {
               // æ„å»ºæ ¼å¼åŒ–çš„æ–‡æœ¬å†…å®¹ï¼ˆæ”¯æŒåŠ ç²—ç­‰Markdownæ ¼å¼ï¼‰
               this.buildFormattedText(line.text)
             }
             .layoutWeight(1)  // æ–‡å­—éƒ¨åˆ†å æ®å‰©ä½™çš„æ‰€æœ‰ç©ºé—´
             .alignItems(HorizontalAlign.Start)  // æ–‡å­—å†…å®¹å·¦å¯¹é½
           }
           .width('100%')  // æ•´ä¸ªRowå æ»¡çˆ¶å®¹å™¨å®½åº¦
           .margin({ bottom: 6 })  // åˆ—è¡¨é¡¹åº•éƒ¨ç•™6åƒç´ é—´è·
           .alignItems(VerticalAlign.Top)  // Rowå†…å®¹é¡¶éƒ¨å¯¹é½ï¼ˆåºå·å’Œæ–‡å­—éƒ½ä»é¡¶éƒ¨å¼€å§‹ï¼‰
         } else {
          // æ™®é€šæ–‡æœ¬
          Column() {
            this.buildFormattedText(line.text)
          }
          .width('100%')
          .margin({ bottom: line.isLast ? 0 : 6 })
        }
      }, (line: LineItem, index: number) => `${index}-${(line.text ?? '').substring(0, 10)}`)
    }
    .width('100%')
    .alignItems(HorizontalAlign.Start)
  }

  /**
   * å°†å†…å®¹åˆ†å‰²ä¸ºè¡Œ
   */
  splitContentToLines(content: string): LineItem[] {
    const safeContent: string = content ?? '';
    const lines: string[] = safeContent.split('\n');
    const totalLines: number = lines.length;
    const result: LineItem[] = [];

    for (let i = 0; i < lines.length; i++) {
      const line = lines[i];
      const trimmed = line.trim();

      if (trimmed === '') {
        result.push({
          text: '',
          isEmpty: true,
          isUnorderedList: false,
          isOrderedList: false,
          number: '',
          isLast: i === totalLines - 1
        });
      } else if (trimmed.startsWith('- ') || trimmed.startsWith('* ')) {
        // æ— åºåˆ—è¡¨ï¼šç§»é™¤å¼€å¤´çš„ "- " æˆ– "* "
        const textAfterBullet = trimmed.substring(2).trim();
        result.push({
          text: textAfterBullet,
          isEmpty: false,
          isUnorderedList: true,
          isOrderedList: false,
          number: '',
          isLast: i === totalLines - 1
        });
      } else {
        const orderedMatch = trimmed.match(/^(\d+\.)\s+(.*)/);
        if (orderedMatch) {
          // æœ‰åºåˆ—è¡¨ï¼šæå–åºå·å’Œæ–‡æœ¬
          result.push({
            text: orderedMatch[2] || '',
            isEmpty: false,
            isUnorderedList: false,
            isOrderedList: true,
            number: orderedMatch[1],
            isLast: i === totalLines - 1
          });
        } else {
          // æ™®é€šæ–‡æœ¬ï¼šç›´æ¥ä½¿ç”¨åŸæ–‡æœ¬
          result.push({
            text: line,
            isEmpty: false,
            isUnorderedList: false,
            isOrderedList: false,
            number: '',
            isLast: i === totalLines - 1
          });
        }
      }
    }

    return result;
  }

  /**
   * æ„å»ºæ ¼å¼åŒ–çš„æ–‡æœ¬ï¼ˆæ”¯æŒåŠ ç²—ã€æ–œä½“ç­‰ï¼‰
   */
  /**
   * æ£€æŸ¥æ–‡æœ¬æ˜¯å¦éœ€è¦ç›´æ¥æ˜¾ç¤ºï¼ˆæ— Markdownæ ¼å¼ï¼‰
   */
  shouldShowPlainText(text: string): boolean {
    const spans = this.parseMarkdownSpans(text);
    return spans.length === 0 || (spans.length === 1 && !spans[0].text);
  }

  @Builder
  buildFormattedText(text: string) {
    if (text && text.trim()) {
      if (this.shouldShowPlainText(text)) {
        // å¦‚æœæ²¡æœ‰spansæˆ–spansä¸ºç©ºï¼Œç›´æ¥æ˜¾ç¤ºåŸæ–‡æœ¬
        Text(text)
          .fontSize(14)
          .fontColor(Constants.COLOR_TEXT_PRIMARY)
          .lineHeight(22)
      } else {
        Text() {
          ForEach(this.parseMarkdownSpans(text), (span: TextSpan, index: number) => {
            if (span.text) {
              Span(span.text)
                .fontSize(14)
                .fontColor(Constants.COLOR_TEXT_PRIMARY)
                .fontWeight(span.bold ? FontWeight.Bold : FontWeight.Normal)
                .fontStyle(span.italic ? FontStyle.Italic : FontStyle.Normal)
            }
          }, (span: TextSpan, index: number) => `${index}-${(span.text ?? '').substring(0, 5)}`)
        }
        .fontSize(14)
        .fontColor(Constants.COLOR_TEXT_PRIMARY)
        .lineHeight(22)
      }
    }
  }

  /**
   * è§£æMarkdownæ–‡æœ¬ä¸ºSpanæ•°ç»„
   */
  parseMarkdownSpans(text: string): TextSpan[] {
    const spans: TextSpan[] = [];

    // åŒ¹é…åŠ ç²— **text** æˆ– __text__
    const boldRegex = /\*\*(.*?)\*\*|__(.*?)__/g;
    let match: RegExpExecArray | null = null;
    const matches: MatchResult[] = [];

    while ((match = boldRegex.exec(text)) !== null) {
      const matchResult: MatchResult = {
        start: match.index,
        end: match.index + match[0].length,
        text: match[1] || match[2] || '',
        bold: true
      };
      matches.push(matchResult);
    }

    // å¦‚æœæ²¡æœ‰åŒ¹é…ï¼Œè¿”å›æ™®é€šæ–‡æœ¬
    if (matches.length === 0) {
      spans.push({ text: text, bold: false, italic: false });
      return spans;
    }

    // æŒ‰ä½ç½®æ’åº
    matches.sort((a, b) => a.start - b.start);

    // æ„å»ºSpanæ•°ç»„
    let lastIndex = 0;
    for (const m of matches) {
      // æ·»åŠ åŠ ç²—å‰çš„æ™®é€šæ–‡æœ¬
      if (m.start > lastIndex) {
        const normalText = text.substring(lastIndex, m.start);
        if (normalText) {
          spans.push({ text: normalText, bold: false, italic: false });
        }
      }

      // æ·»åŠ åŠ ç²—æ–‡æœ¬
      spans.push({ text: m.text, bold: true, italic: false });
      lastIndex = m.end;
    }

    // æ·»åŠ å‰©ä½™æ–‡æœ¬
    if (lastIndex < text.length) {
      const remainingText = text.substring(lastIndex);
      if (remainingText) {
        spans.push({ text: remainingText, bold: false, italic: false });
      }
    }

    return spans.length > 0 ? spans : [{ text: text, bold: false, italic: false }];
  }
}


