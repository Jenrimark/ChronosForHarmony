    getCategoryName(category) {
        const categoryMap = new Map([
            ['food', 'é¤é¥®'],
            ['transport', 'äº¤é€š'],
            ['shopping', 'è´­ç‰©'],
            ['entertainment', 'å¨±ä¹'],
            ['medical', 'åŒ»ç–—'],
            ['education', 'æ•™è‚²'],
            ['housing', 'ä½æˆ¿'],
            ['utilities', 'æ°´ç”µ'],
            ['salary', 'å·¥èµ„'],
            ['bonus', 'å¥–é‡‘'],
            ['investment', 'æŠ•èµ„'],
            ['gift', 'ç¤¼é‡‘'],
            ['other_expense', 'å…¶ä»–æ”¯å‡º'],
            ['other_income', 'å…¶ä»–æ”¶å…¥']
        ]);
        return categoryMap.get(category) || category;
    }
