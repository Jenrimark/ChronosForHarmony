        const c2 = { name: 'æ°´ç“¶åº§', startMonth: 1, startDate: 20, endMonth: 2, endDate: 18 };
        const c3 = { name: 'åŒé±¼åº§', startMonth: 2, startDate: 19, endMonth: 3, endDate: 20 };
        const c4 = { name: 'ç™½ç¾Šåº§', startMonth: 3, startDate: 21, endMonth: 4, endDate: 19 };
        const c5 = { name: 'é‡‘ç‰›åº§', startMonth: 4, startDate: 20, endMonth: 5, endDate: 20 };
        const c6 = { name: 'åŒå­åº§', startMonth: 5, startDate: 21, endMonth: 6, endDate: 21 };
        const c7 = { name: 'å·¨èŸ¹åº§', startMonth: 6, startDate: 22, endMonth: 7, endDate: 22 };
        const c8 = { name: 'ç‹®å­åº§', startMonth: 7, startDate: 23, endMonth: 8, endDate: 22 };
        const c9 = { name: 'å¤„å¥³åº§', startMonth: 8, startDate: 23, endMonth: 9, endDate: 22 };
        const c10 = { name: 'å¤©ç§¤åº§', startMonth: 9, startDate: 23, endMonth: 10, endDate: 23 };
        const c11 = { name: 'å¤©èåº§', startMonth: 10, startDate: 24, endMonth: 11, endDate: 22 };
        const c12 = { name: 'å°„æ‰‹åº§', startMonth: 11, startDate: 23, endMonth: 12, endDate: 21 };
