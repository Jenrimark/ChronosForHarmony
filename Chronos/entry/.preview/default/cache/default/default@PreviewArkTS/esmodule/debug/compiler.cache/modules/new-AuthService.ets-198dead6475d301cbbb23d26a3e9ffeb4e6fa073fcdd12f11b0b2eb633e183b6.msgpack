  /**
   * åˆå§‹åŒ– Auth SDK
   */
  private initAuth(): boolean {
    if (this.isInitialized) {
      return true;
    }

    if (!this.context) {
      hilog.error(0x0000, TAG, 'Context æœªè®¾ç½®ï¼Œæ— æ³•åˆå§‹åŒ– Auth');
