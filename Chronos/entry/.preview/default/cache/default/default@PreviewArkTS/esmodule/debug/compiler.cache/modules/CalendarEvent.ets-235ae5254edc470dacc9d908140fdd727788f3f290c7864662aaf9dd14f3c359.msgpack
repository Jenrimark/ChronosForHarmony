export function getReminderTypeText(type: ReminderType): string {
  if (type === ReminderType.NONE) return 'æ— æé†’';
  if (type === ReminderType.AT_TIME) return 'å‡†æ—¶';
  if (type === ReminderType.FIVE_MIN) return '5åˆ†é’Ÿå‰';
  if (type === ReminderType.TEN_MIN) return '10åˆ†é’Ÿå‰';
  if (type === ReminderType.THIRTY_MIN) return '30åˆ†é’Ÿå‰';
  if (type === ReminderType.ONE_HOUR) return '1å°æ—¶å‰';
  if (type === ReminderType.ONE_DAY) return '1å¤©å‰';
  return 'æ— æé†’';
}

/**
 * é‡å¤è§„åˆ™æ˜¾ç¤ºæ–‡æœ¬
 */
export function getRepeatRuleText(rule: RepeatRule): string {
  if (rule === RepeatRule.NONE) return 'ä¸é‡å¤';
  if (rule === RepeatRule.DAILY) return 'æ¯å¤©';
  if (rule === RepeatRule.WEEKLY) return 'æ¯å‘¨';
  if (rule === RepeatRule.MONTHLY) return 'æ¯æœˆ';
  if (rule === RepeatRule.YEARLY) return 'æ¯å¹´';
  return 'ä¸é‡å¤';
}

/**
