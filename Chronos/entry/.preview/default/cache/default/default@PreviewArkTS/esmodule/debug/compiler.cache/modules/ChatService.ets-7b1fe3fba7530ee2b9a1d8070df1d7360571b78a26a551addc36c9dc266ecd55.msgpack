                const dueDateText = task.dueDate ?
                    `æˆªæ­¢æ—¥æœŸï¼š${this.formatDateForAI(new Date(task.dueDate))}` : 'æ— æˆªæ­¢æ—¥æœŸ';
                systemContent += `${index + 1}. ${task.title || 'æ— æ ‡é¢˜'}\n`;
