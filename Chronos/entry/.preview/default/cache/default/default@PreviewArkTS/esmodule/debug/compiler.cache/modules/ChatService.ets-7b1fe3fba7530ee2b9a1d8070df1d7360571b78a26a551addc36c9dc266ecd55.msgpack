  ): void {
    let systemContent = 'ä½ æ˜¯è¾°åºåŠ©æ‰‹ï¼Œä¸€ä¸ªæ™ºèƒ½çš„ç”Ÿæ´»ç®¡ç†åŠ©æ‰‹ã€‚ä½ å¯ä»¥å¸®åŠ©ç”¨æˆ·ç®¡ç†ä»»åŠ¡ã€è®°è´¦ã€æä¾›å»ºè®®ç­‰ã€‚è¯·ç”¨å‹å¥½ã€ä¸“ä¸šçš„è¯­æ°”å›å¤ç”¨æˆ·ã€‚\n\n';
    
    systemContent += 'ä»¥ä¸‹æ˜¯ç”¨æˆ·å½“å‰çš„æœ¬åœ°æ•°æ®åº“å†…å®¹ï¼Œä½ å¯ä»¥éšæ—¶æŸ¥è¯¢å’Œä½¿ç”¨è¿™äº›ä¿¡æ¯æ¥å›ç­”ç”¨æˆ·çš„é—®é¢˜ï¼š\n\n';
    
    // ä»»åŠ¡åˆ—è¡¨
    systemContent += '=== ä»»åŠ¡åˆ—è¡¨ ===\n';
    if (tasks.length === 0) {
      systemContent += 'æš‚æ— ä»»åŠ¡ã€‚\n';
    } else {
      tasks.forEach((task, index) => {
        const statusText = task.status === 'completed' ? 'å·²å®Œæˆ' : 
                          task.status === 'in_progress' ? 'è¿›è¡Œä¸­' : 'å¾…åŠ';
        const priorityText = task.priority === 3 ? 'é«˜' : 
                             task.priority === 2 ? 'ä¸­' : 'ä½';
        const dueDateText = task.dueDate ? 
          `æˆªæ­¢æ—¥æœŸï¼š${this.formatDateForAI(new Date(task.dueDate))}` : 'æ— æˆªæ­¢æ—¥æœŸ';
        systemContent += `${index + 1}. ${task.title || 'æ— æ ‡é¢˜'}\n`;
        if (task.description) {
          systemContent += `   æè¿°ï¼š${task.description}\n`;
        }
        systemContent += `   çŠ¶æ€ï¼š${statusText} | ä¼˜å…ˆçº§ï¼š${priorityText} | ${dueDateText}\n`;
        if (task.tags && task.tags.length > 0) {
          systemContent += `   æ ‡ç­¾ï¼š${task.tags.join(', ')}\n`;
        }
        systemContent += '\n';
      });
    }
    
    systemContent += '\n=== æ—¥ç¨‹å®‰æ’ ===\n';
    if (events.length === 0) {
      systemContent += 'æš‚æ— æ—¥ç¨‹ã€‚\n';
    } else {
      events.forEach((event, index) => {
        // å¤„ç†startTimeå’ŒendTimeï¼ˆå¯èƒ½æ˜¯Dateå¯¹è±¡æˆ–æ—¶é—´æˆ³ï¼‰
        const startDate = event.startTime instanceof Date ? event.startTime : new Date(event.startTime);
        const endDate = event.endTime instanceof Date ? event.endTime : new Date(event.endTime);
        const timeText = event.isAllDay ? 
          `å…¨å¤©ï¼š${this.formatDateForAI(startDate)}` :
          `${this.formatDateForAI(startDate)} ${this.formatTimeForAI(startDate)} - ${this.formatTimeForAI(endDate)}`;
        systemContent += `${index + 1}. ${event.title || 'æ— æ ‡é¢˜'}\n`;
        systemContent += `   æ—¶é—´ï¼š${timeText}\n`;
        if (event.location) {
          systemContent += `   åœ°ç‚¹ï¼š${event.location}\n`;
        }
        if (event.reminder && event.reminder !== 'none') {
          systemContent += `   æé†’ï¼š${event.reminder}\n`;
        }
        if (event.repeatRule && event.repeatRule !== 'none') {
          systemContent += `   é‡å¤ï¼š${event.repeatRule}\n`;
        }
        systemContent += '\n';
      });
    }
    
    systemContent += '\n=== è®°è´¦ä¿¡æ¯ ===\n';
    if (bills.length === 0) {
      systemContent += 'æš‚æ— è´¦å•è®°å½•ã€‚\n';
    } else {
      // æŒ‰æ—¥æœŸåˆ†ç»„æ˜¾ç¤º
      const billsByDate = new Map<string, Bill[]>();
      bills.forEach(bill => {
        const dateKey = this.formatDateForAI(new Date(bill.date));
        if (!billsByDate.has(dateKey)) {
          billsByDate.set(dateKey, []);
        }
        const dateBills = billsByDate.get(dateKey);
        if (dateBills) {
          dateBills.push(bill);
        }
      });
      
      const sortedDates = Array.from(billsByDate.keys()).sort().reverse(); // æœ€æ–°çš„åœ¨å‰
      sortedDates.forEach(date => {
        const dateBills = billsByDate.get(date);
        if (!dateBills) {
          return;
        }
        systemContent += `${date}ï¼š\n`;
        dateBills.forEach((bill, index) => {
          // Billå¯¹è±¡æœ‰isIncomeæ–¹æ³•
          const isIncome = bill.isIncome();
          const typeText = isIncome ? 'æ”¶å…¥' : 'æ”¯å‡º';
          const categoryText = this.getCategoryName(bill.category || '');
          systemContent += `   ${index + 1}. ${typeText} Â¥${bill.amount.toFixed(2)} - ${categoryText}`;
          if (bill.description) {
            systemContent += ` (${bill.description})`;
          }
          systemContent += '\n';
        });
        systemContent += '\n';
      });
    }
    
    systemContent += '\nè¯·æ ¹æ®ä»¥ä¸Šä¿¡æ¯å›ç­”ç”¨æˆ·çš„é—®é¢˜ã€‚å¦‚æœç”¨æˆ·è¯¢é—®å…·ä½“çš„æ•°æ®ï¼Œè¯·å‡†ç¡®å¼•ç”¨ä¸Šè¿°ä¿¡æ¯ã€‚';
    
    // æ›´æ–°ç³»ç»Ÿæ¶ˆæ¯
    if (this.conversationHistory.length > 0 && this.conversationHistory[0].role === 'system') {
      this.conversationHistory[0].content = systemContent;
    } else {
      this.conversationHistory.unshift({
        role: 'system',
        content: systemContent
      });
    }
  }
  
  /**
   * æ ¼å¼åŒ–æ—¥æœŸç”¨äºAIæ˜¾ç¤º
   */
  private formatDateForAI(date: Date): string {
    const year = date.getFullYear();
    const month = String(date.getMonth() + 1).padStart(2, '0');
    const day = String(date.getDate()).padStart(2, '0');
    return `${year}-${month}-${day}`;
  }
  
  /**
   * æ ¼å¼åŒ–æ—¶é—´ç”¨äºAIæ˜¾ç¤º
   */
  private formatTimeForAI(date: Date): string {
    const hours = String(date.getHours()).padStart(2, '0');
    const minutes = String(date.getMinutes()).padStart(2, '0');
    return `${hours}:${minutes}`;
  }
  
  /**
   * è·å–åˆ†ç±»åç§°
   */
  private getCategoryName(category: string): string {
    const categoryMap: Map<string, string> = new Map([
      ['food', 'é¤é¥®'],
      ['transport', 'äº¤é€š'],
      ['shopping', 'è´­ç‰©'],
      ['entertainment', 'å¨±ä¹'],
      ['medical', 'åŒ»ç–—'],
      ['education', 'æ•™è‚²'],
      ['housing', 'ä½æˆ¿'],
      ['utilities', 'æ°´ç”µ'],
      ['salary', 'å·¥èµ„'],
      ['bonus', 'å¥–é‡‘'],
      ['investment', 'æŠ•èµ„'],
      ['gift', 'ç¤¼é‡‘'],
      ['other_expense', 'å…¶ä»–æ”¯å‡º'],
      ['other_income', 'å…¶ä»–æ”¶å…¥']
    ]);
    return categoryMap.get(category) || category;
  }

  /**
   * æ¸…ç©ºå¯¹è¯å†å²
   */
  clearHistory(): void {
    this.conversationHistory = [
      {
        role: 'system',
        content: 'ä½ æ˜¯è¾°åºåŠ©æ‰‹ï¼Œä¸€ä¸ªæ™ºèƒ½çš„ç”Ÿæ´»ç®¡ç†åŠ©æ‰‹ã€‚ä½ å¯ä»¥å¸®åŠ©ç”¨æˆ·ç®¡ç†ä»»åŠ¡ã€è®°è´¦ã€æä¾›å»ºè®®ç­‰ã€‚è¯·ç”¨å‹å¥½ã€ä¸“ä¸šçš„è¯­æ°”å›å¤ç”¨æˆ·ã€‚'
      }
    ];
  }

  /**
   * è·å–å¯¹è¯å†å²
   */
  getHistory(): ChatMessage[] {
    return [...this.conversationHistory];
  }
}

