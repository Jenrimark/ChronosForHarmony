            return 1;
        if (day === 'æ˜ŸæœŸäºŒ')
            return 2;
        if (day === 'æ˜ŸæœŸä¸‰')
            return 3;
        if (day === 'æ˜ŸæœŸå››')
            return 4;
        if (day === 'æ˜ŸæœŸäº”')
            return 5;
        if (day === 'æ˜ŸæœŸå…­')
            return 6;
        if (day === 'æ˜ŸæœŸæ—¥')
            return 7;
        return 1;
    }
