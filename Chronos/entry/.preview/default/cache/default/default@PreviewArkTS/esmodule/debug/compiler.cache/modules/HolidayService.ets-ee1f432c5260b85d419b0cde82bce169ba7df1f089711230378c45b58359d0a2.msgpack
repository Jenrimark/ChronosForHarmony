    /**
     * ä»APIåŠ è½½æ•´å¹´æ•°æ®
     */
    async loadYearDataFromAPI(year) {
        try {
            const url = `${Constants.MXNZP_HOLIDAY_URL}/${year}?ignoreHoliday=false&app_id=${Constants.MXNZP_APP_ID}&app_secret=${Constants.MXNZP_APP_SECRET}`;
            console.info(`HolidayService: æ­£åœ¨ä»APIåŠ è½½ ${year} å¹´æ•°æ®...`);
            const httpRequest = http.createHttp();
            const response = await httpRequest.request(url, {
                method: http.RequestMethod.GET,
                connectTimeout: 10000,
                readTimeout: 10000
            });
            if (response.responseCode !== 200) {
                throw new Error(`APIè¯·æ±‚å¤±è´¥ï¼ŒçŠ¶æ€ç : ${response.responseCode}`);
            }
            const responseText = await response.result.toString();
            const data = JSON.parse(responseText);
            if (data.code !== 1 || !data.data) {
                throw new Error(`APIè¿”å›é”™è¯¯: ${data.msg || 'æœªçŸ¥é”™è¯¯'}`);
            }
            // è°ƒè¯•ï¼šæ‰“å°APIè¿”å›çš„åŸå§‹æ•°æ®ç»“æ„ï¼ˆå‰3æ¡ï¼‰
            console.info(`HolidayService: APIè¿”å›æ•°æ®ç¤ºä¾‹ï¼ˆå‰3æ¡ï¼‰:`);
            for (let i = 0; i < Math.min(3, data.data.length); i++) {
                const item = data.data[i];
                console.info(`HolidayService: [${i}] date: ${item.date}, suit: "${item.suit}", avoid: "${item.avoid}"`);
                console.info(`HolidayService: [${i}] å®Œæ•´æ•°æ®:`, JSON.stringify(item));
            }
            // ç¼“å­˜æ•´å¹´æ•°æ®
            this.yearDataCache.set(year, data.data);
            console.info(`HolidayService: æˆåŠŸåŠ è½½ ${year} å¹´æ•°æ®ï¼Œå…± ${data.data.length} æ¡`);
            httpRequest.destroy();
        }
        catch (error) {
            console.error(`HolidayService: åŠ è½½ ${year} å¹´APIæ•°æ®å¤±è´¥:`, error);
            // ArkTSè¦æ±‚throwåªèƒ½æŠ›å‡ºErrorç±»å‹
            const errorMessage = error instanceof Error ? error.message : String(error);
            throw new Error(`åŠ è½½ ${year} å¹´APIæ•°æ®å¤±è´¥: ${errorMessage}`);
        }
    }
    /**
     * è·å–æŒ‡å®šæ—¥æœŸçš„ä¸‡å¹´å†ä¿¡æ¯
     */
    async getCalendarInfo(date) {
        const dateKey = this.getDateKey(date);
