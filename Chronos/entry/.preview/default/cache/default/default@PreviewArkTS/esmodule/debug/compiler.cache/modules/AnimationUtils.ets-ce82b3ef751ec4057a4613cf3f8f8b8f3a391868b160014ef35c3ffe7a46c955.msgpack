        TransitionEffect.translate({ y: 100 })
          .animation({
            duration: Constants.ANIMATION_DURATION_NORMAL,
            curve: Curve.EaseOut
          })
      );
  }

  /**
   * æ»‘åˆ°åº•éƒ¨
   */
  static slideToBottom(): TransitionEffect {
    return TransitionEffect.OPACITY
      .animation({
        duration: Constants.ANIMATION_DURATION_NORMAL,
        curve: Curve.EaseIn
      })
      .combine(
        TransitionEffect.translate({ y: 100 })
          .animation({
            duration: Constants.ANIMATION_DURATION_NORMAL,
            curve: Curve.EaseIn
          })
      );
  }
}

/**
 * åˆ—è¡¨é¡¹åŠ¨ç”»é…ç½®
 */
export class ListItemAnimationUtils {
  /**
   * åˆ—è¡¨é¡¹è¿›å…¥åŠ¨ç”»
   */
  static itemEnter(index: number): TransitionEffect {
    return TransitionEffect.OPACITY
      .animation({
        duration: Constants.ANIMATION_DURATION_FAST,
        curve: Curve.EaseOut,
        delay: index * 50 // é”™å¼€åŠ¨ç”»ï¼Œå½¢æˆæ³¢æµªæ•ˆæœ
      })
      .combine(
        TransitionEffect.translate({ x: -20 })
          .animation({
            duration: Constants.ANIMATION_DURATION_FAST,
            curve: Curve.EaseOut,
            delay: index * 50
          })
      );
  }

  /**
   * åˆ—è¡¨é¡¹åˆ é™¤åŠ¨ç”»
   */
  static itemDelete(): TransitionEffect {
    return TransitionEffect.OPACITY
      .animation({
        duration: Constants.ANIMATION_DURATION_FAST,
        curve: Curve.EaseIn
      })
      .combine(
        TransitionEffect.translate({ x: 100 })
          .animation({
            duration: Constants.ANIMATION_DURATION_FAST,
            curve: Curve.EaseIn
          })
      );
  }

  /**
   * åˆ—è¡¨é¡¹å®ŒæˆåŠ¨ç”»ï¼ˆæ‰“å‹¾æ•ˆæœï¼‰
   */
  static itemComplete(): AnimateParam {
    return {
      duration: Constants.ANIMATION_DURATION_FAST,
      curve: Curve.EaseInOut, // ä½¿ç”¨ EaseInOut æ›¿ä»£ Spring
      playMode: PlayMode.Normal
    };
  }
}

/**
 * åŠ è½½åŠ¨ç”»é…ç½®
 */
export class LoadingAnimationUtils {
  /**
   * éª¨æ¶å±é—ªçƒåŠ¨ç”»
   */
  static skeletonShimmer(): AnimateParam {
    return {
      duration: 1500,
      curve: Curve.Linear,
      iterations: -1, // æ— é™å¾ªç¯
      playMode: PlayMode.Normal
    };
  }

  /**
   * æ—‹è½¬åŠ è½½åŠ¨ç”»
   */
  static rotate(): AnimateParam {
    return {
      duration: 1000,
      curve: Curve.Linear,
      iterations: -1,
      playMode: PlayMode.Normal
    };
  }

  /**
   * è„‰å†²åŠ¨ç”»
   */
  static pulse(): AnimateParam {
    return {
      duration: 1000,
      curve: Curve.EaseInOut,
      iterations: -1,
      playMode: PlayMode.Alternate
    };
  }
}

/**
 * æŒ‰é’®åŠ¨ç”»é…ç½®
 */
export class ButtonAnimationUtils {
  /**
   * æŒ‰é’®æŒ‰ä¸‹åŠ¨ç”»
   */
  static press(): AnimateParam {
    return {
      duration: 100,
      curve: Curve.EaseOut,
      playMode: PlayMode.Normal
    };
  }

  /**
   * æŒ‰é’®é‡Šæ”¾åŠ¨ç”»
   */
  static release(): AnimateParam {
    return {
      duration: 150,
      curve: Curve.EaseOut, // ä½¿ç”¨ EaseOut æ›¿ä»£ Spring
      playMode: PlayMode.Normal
    };
  }

  /**
   * æŒ‰é’®æ‚¬åœåŠ¨ç”»
   */
  static hover(): AnimateParam {
    return {
      duration: Constants.ANIMATION_DURATION_FAST,
      curve: Curve.EaseOut,
      playMode: PlayMode.Normal
    };
  }
}

/**
 * å¡ç‰‡åŠ¨ç”»é…ç½®
 */
export class CardAnimationUtils {
  /**
   * å¡ç‰‡æ‚¬åœä¸Šæµ®æ•ˆæœ
   */
  static hoverLift(): AnimateParam {
    return {
      duration: Constants.ANIMATION_DURATION_FAST,
      curve: Curve.EaseOut,
      playMode: PlayMode.Normal
    };
  }

  /**
   * å¡ç‰‡ç‚¹å‡»åé¦ˆ
   */
  static tap(): AnimateParam {
    return {
      duration: 100,
      curve: Curve.EaseOut,
      playMode: PlayMode.Normal
    };
  }

  /**
   * å¡ç‰‡å±•å¼€åŠ¨ç”»
   */
  static expand(): AnimateParam {
    return {
