    const c5: ConstellationInfo = { name: 'é‡‘ç‰›åº§', startMonth: 4, startDate: 20, endMonth: 5, endDate: 20 };
    const c6: ConstellationInfo = { name: 'åŒå­åº§', startMonth: 5, startDate: 21, endMonth: 6, endDate: 21 };
